{% set article = paragraph.field_featured_focus_article.entity ?? null %}
{% set image_position = paragraph.field_focus_image_side.value|default('right') %}

{% if article %}
  {% set image_media = article.field_hero_image.entity ?? null %}
  {% set image_file = image_media ? image_media.field_media_image.entity : null %}

  {{ include('omd:featured-focus', {
    label: 'Featured focus',
    title: article.label,
    summary: article.field_summary.value|default(''),
    image_src: image_file ? file_url(image_file.uri.value) : '',
    image_alt: image_media and image_media.field_media_image.alt ? image_media.field_media_image.alt : '',
    image_position: image_position,
    link_url: path('entity.node.canonical', {'node': article.id}),
    link_label: 'Read more',
    classes: [
      'paragraph',
      'paragraph--type-featured-focus',
      view_mode ? 'paragraph--view-mode-' ~ view_mode|clean_class
    ]
  }, false) }}
{% endif %}
