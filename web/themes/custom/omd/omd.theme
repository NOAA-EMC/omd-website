<?php

/**
 * @file
 * USWDS Base sub-theme.
 *
 * Place your custom PHP code in this file.
 */

/**
 * Implements hook_preprocess().
 */
function omd_preprocess(&$variables) {
  // Set the path to the base theme.
  $variables['active_theme_path'] = base_path() . \Drupal::theme()->getActiveTheme()->getPath();
  $variables['uswds_images'] = $variables['active_theme_path'] . '/assets/uswds/img/';
}

/**
 * Implements hook_preprocess_node().
 */
function omd_preprocess_node(&$variables) {
  $node = $variables['node'];

  if ($node->bundle() === 'article') {
    $variables['article_hero_image_uri'] = NULL;

    if ($node->hasField('field_hero_image') && !$node->get('field_hero_image')->isEmpty()) {
      $media = $node->get('field_hero_image')->entity;
      if ($media && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
        $file = $media->get('field_media_image')->entity;
        if ($file) {
          $variables['article_hero_image_uri'] = \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
        }
      }
    }
  }
}