{% stories uswds_card with { title: 'OMD/Components/Card' } %}

{% story standard with { name: 'Standard' } %}
<ul class="usa-card-group">
	{{ include('omd:card', {
		heading: 'Forecast guidance',
		body: 'Explore the latest model guidance and forecast resources from OMD.',
		link_label: 'View forecast guidance',
		link_url: '/forecast-guidance',
		class: 'tablet:grid-col-6 desktop:grid-col-4'
	}, false) }}
</ul>
{% endstory %}

{% story with_image with { name: 'With image' } %}
<ul class="usa-card-group">
	{{ include('omd:card', {
		heading: 'Model development',
		body: 'Learn how OMD advances the models that support weather prediction.',
		image_src: '/themes/custom/omd/assets/images/cards/model-development.png',
		image_alt: 'Line chart with data points over a contour map',
		link_label: 'Explore model development',
		link_url: '/model-development',
		class: 'tablet:grid-col-6 desktop:grid-col-4'
	}, false) }}
</ul>
{% endstory %}

