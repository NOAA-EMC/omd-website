{% set hero_heading = hero_heading|default('') %}
{% set hero_image_uri = hero_image_uri|default(null) %}
{% set hero_body = hero_body|default('') %}
{% set call_to_action_label = call_to_action_label|default('') %}
{% set call_to_action_url = call_to_action_url|default('') %}
{% set variant = variant|default('default') %}

{% set section_classes = 'usa-hero' %}
{% if variant == 'contained' %}
	{% set section_classes = section_classes ~ ' usa-hero--contained' %}
{% endif %}

<section class="{{ section_classes }}" aria-label="{{ hero_heading }}">
	{% if hero_image_uri %}
		<div class="usa-hero__media" aria-hidden="true">
			<img src="{{ file_url(hero_image_uri) }}" alt="" fetchpriority="high">
		</div>
	{% endif %}
	<div class="usa-hero__wrapper">
		<div class="grid-container">
			<div class="usa-hero__callout">
				<h1 class="usa-hero__heading">{{ hero_heading }}</h1>
				{% if hero_body %}
					<p>{{ hero_body }}</p>
				{% endif %}
				{% if call_to_action_label and call_to_action_url %}
					<a class="usa-button" href="{{ call_to_action_url }}">{{ call_to_action_label }}</a>
				{% endif %}
			</div>
		</div>
	</div>
</section>
