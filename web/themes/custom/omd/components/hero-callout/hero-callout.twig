{% set heading = heading|default('Weather and climate guidance') %}
{% set body = body|default('Explore the latest forecasts, model guidance, and research from the Office of Modeling and Development.') %}
{% set cta_label = cta_label|default('') %}
{% set cta_url = cta_url|default('') %}

<section class="usa-hero omd-hero-callout" aria-label="{{ heading }}">
	<div class="grid-container">
		<div class="usa-hero__callout omd-hero-callout__content">
			<h1 class="usa-hero__heading">{{ heading }}</h1>
			<p>{{ body }}</p>
			{% if cta_label and cta_url %}
				<a class="usa-button" href="{{ cta_url }}">{{ cta_label }}</a>
			{% endif %}
		</div>
	</div>
</section>
