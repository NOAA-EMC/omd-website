{% stories event with { title: 'OMD/Content/Event' } %}

{% story event_detail with { name: 'Event detail' } %}
{% set event_format %}<span>Seminar</span>{% endset %}
{% set event_location %}<span>Virtual seminar</span>{% endset %}
{% set event_tags %}
  <a href="/taxonomy/term/1" class="usa-tag">Hurricanes</a>
  <a href="/taxonomy/term/2" class="usa-tag">Forecast guidance</a>
{% endset %}
{% set event_details %}
  <h2>About this seminar</h2>
  <p>Join OMD researchers for a discussion of new approaches to hurricane intensity prediction.</p>
{% endset %}

{{ include('omd:event', {
  event_title: 'Modeling Seminar: Advancing hurricane prediction',
  event_summary: 'A seminar on new approaches to hurricane intensity prediction and their operational applications.',
  event_format: event_format,
  event_start_value: '2026-11-12T14:00:00-05:00',
  event_end_value: '2026-11-12T15:00:00-05:00',
  event_location: event_location,
  event_recurring: true,
  event_link_url: 'https://example.com/register',
  event_link_label: 'Register for the seminar',
  event_tags: event_tags,
  event_details: event_details
}, false) }}
{% endstory %}

{% endstories %}
