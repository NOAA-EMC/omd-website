{% stories article with { title: 'Content/Article' } %}

{% story article_content_type with { name: 'Article Content Type' } %}
{% set guidance_text %}
  <p>Current guidance highlights a developing low-pressure system moving across the region.</p>
{% endset %}
{% set assessment_text %}
  <p>Ensemble agreement is improving, though uncertainty remains in the timing and track.</p>
  <p>Forecasters should continue monitoring updates as additional observations become available.</p>
{% endset %}
{% set article_sections %}
  <div class="article-sections">
    {{ include('omd:paragraph-section', { heading: 'Forecast guidance', text: guidance_text }, false) }}
    {{ include('omd:paragraph-section', { heading: 'Model assessment', text: assessment_text }, false) }}
  </div>
{% endset %}

{% set article_tags %}
  <a href="/taxonomy/term/1" class="usa-tag">Forecast guidance</a>
  <a href="/taxonomy/term/2" class="usa-tag">Severe weather</a>
  <a href="/taxonomy/term/3" class="usa-tag">Model development</a>
{% endset %}

{{ include('omd:article', {
  article_title: 'Understanding the latest forecast guidance',
  article_hero_image_uri: 'themes/custom/omd/assets/images/hero-callout-banner.png',
  article_publication_date: 'November 5, 2026',
  article_summary: 'A review of current model guidance, forecast confidence, and the factors forecasters are monitoring.',
  article_author: 'Office of Modeling and Development',
  article_sections: article_sections,
  article_tags: article_tags,
  article_tags_label: 'Related topics'
}, false) }}
{% endstory %}

{% endstories %}
